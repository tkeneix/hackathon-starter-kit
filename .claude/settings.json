{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(tools/bin/flow.sh status*)",
      "Bash(tools/bin/flow.sh check*)",
      "Bash(tools/bin/flow.sh start *)",
      "Bash(tools/bin/flow.sh pr*)",
      "Bash(tools/bin/flow.sh sync*)",
      "Bash(tools/bin/flow.sh list*)",
      "Bash(tools/bin/flow.sh prune)",
      "Bash(tools/bin/flow.sh prune --days *)",
      "Bash(uv sync*)",
      "Bash(uv run pytest*)",
      "Bash(uv run ruff *)",
      "Bash(shellcheck *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(gh pr view*)",
      "Bash(gh pr list*)",
      "Bash(gh pr checks*)",
      "Bash(gh pr diff*)"
    ],
    "ask": [
      "Bash(*flow.sh merge*)",
      "Bash(*gh pr merge*)",
      "Bash(*flow.sh approve*)",
      "Bash(*gh pr review*)",
      "Bash(*gh api*)",
      "Bash(*flow.sh protect*)",
      "Bash(*flow.sh prune*--execute*)",
      "Bash(*git push*--force*)",
      "Bash(*git push*-f *)",
      "Bash(*git push*main*)",
      "Bash(*--no-verify*)",
      "Bash(*git reset --hard*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./**/.env)",
      "Read(./.env.local)",
      "Read(./**/.env.local)",
      "Read(./.env.*.local)",
      "Read(./**/.env.*.local)",
      "Read(./.env.production)",
      "Read(./**/.env.production)",
      "Read(./.env.development)",
      "Read(./**/.env.development)",
      "Read(./secrets/**)",
      "Read(./.git/git-credentials)",
      "Edit(./.env)",
      "Edit(./**/.env)",
      "Edit(./.env.local)",
      "Edit(./**/.env.local)",
      "Edit(./.env.*.local)",
      "Edit(./**/.env.*.local)",
      "Edit(./.env.production)",
      "Edit(./**/.env.production)",
      "Edit(./.env.development)",
      "Edit(./**/.env.development)",
      "Edit(./secrets/**)",
      "Edit(./.git/git-credentials)",
      "Write(./.env)",
      "Write(./**/.env)",
      "Write(./.env.local)",
      "Write(./**/.env.local)",
      "Write(./.env.*.local)",
      "Write(./**/.env.*.local)",
      "Write(./.env.production)",
      "Write(./**/.env.production)",
      "Write(./.env.development)",
      "Write(./**/.env.development)",
      "Write(./secrets/**)",
      "Write(./.git/git-credentials)"
    ]
  }
}
